# ==========================================
# MediBillDo Environment Configuration
# ==========================================

# Database Configuration (Neon Serverless PostgreSQL)
# For production, use the pooled connection string (recommended by Neon)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
# BETTER_AUTH_SECRET: Generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET="your-32-character-random-secret"
# BETTER_AUTH_URL: Set to http://localhost:3000 in dev, or your production URL (e.g., https://yourdomain.com)
BETTER_AUTH_URL="http://localhost:3000"

# Resend Email Configuration (Transactional Emails)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_SENDER_NAME="medibilldo"
EMAIL_SENDER_ADDRESS="noreply@yourdomain.com"